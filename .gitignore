.env
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/debugbar/*
writable/uploads/registrations/*
!writable/uploads/registrations/index.html
public/uploads/*
!public/uploads/.htaccess
!public/uploads/index.html
